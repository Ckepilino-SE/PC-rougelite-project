  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: '<b>Parry</b> just as an attack or bullet reaches you to block it. Bullets bounce back at enemies.


    <b><color=#FFD24D>Perfect parry</color></b> (very tight timing) <b>steals the enemy''s power</b>. Steal it again to level it up.


    Chain parries without getting hit to build <b><color=#66C2FF>TEMPO</color></b>: more damage and more score.


    <b>Bosses and elites are armoured.</b> Parry them and hit them with reflected shots to fill their posture bar and <b>STAGGER</b> them.


    Enemies flash <color=#FF5555>red</color> before a lunge and <color=#FFE04D>yellow</color> before shooting.'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
